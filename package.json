{
  "name": "playwright-mcp-ecommerce",
  "version": "1.0.0",
  "description": "Playwright MCP 이커머스 자동화 시스템",
  "type": "module",
  "main": "mcp-server/server.js",
  "scripts": {
    "test": "npx playwright test",
    "test:selectors": "node tests/selector.test.js",
    "codegen": "npx playwright codegen",
    "codegen:naver": "npx playwright codegen https://nid.naver.com/nidlogin.login",
    "codegen:seller": "npx playwright codegen https://sell.smartstore.naver.com",
    "login:naver": "node naver_login.js",
    "blog:pdf-batch": "node scripts/naver-blog-pdf-batch.js",
    "skill:naver-login": "node skills/auth/naver.login.js",
    "skill:naver-login:save": "node skills/auth/naver.login.js --save-session",
    "skill:price-monitor": "node skills/scraping/price.monitor.js",
    "skill:direct-delivery": "node skills/claims/direct.delivery.js",
    "skill:direct-delivery:list": "node skills/claims/direct.delivery.js --list",
    "skill:direct-delivery:dry": "node skills/claims/direct.delivery.js --dry-run",
    "skill:delay-handler": "node skills/claims/delay.handler.js",
    "skill:delay-handler:list": "node skills/claims/delay.handler.js --list",
    "skill:delay-handler:dry": "node skills/claims/delay.handler.js --dry-run",
    "skill:return-handler": "node skills/claims/return.handler.js",
    "skill:return-handler:list": "node skills/claims/return.handler.js --list",
    "skill:return-handler:dry": "node skills/claims/return.handler.js --dry-run",
    "skill:exchange-handler": "node skills/claims/exchange.handler.js",
    "skill:exchange-handler:list": "node skills/claims/exchange.handler.js --list",
    "skill:exchange-handler:dry": "node skills/claims/exchange.handler.js --dry-run",
    "skill:vat-collect": "node skills/monthly/vat.collector.js",
    "skill:vat-collect:dry": "node skills/monthly/vat.collector.js --dry-run",
    "skill:coupon-apply": "node skills/monthly/coupon.applier.js",
    "skill:coupon-apply:list": "node skills/monthly/coupon.applier.js --list",
    "skill:coupon-apply:dry": "node skills/monthly/coupon.applier.js --dry-run",
    "skill:invoice-collect": "node skills/wholesale/invoice.collector.js",
    "skill:invoice-collect:all": "node skills/wholesale/invoice.collector.js --all",
    "skill:invoice-collect:dry": "node skills/wholesale/invoice.collector.js --dry-run",
    "skill:inquiry-send": "node skills/wholesale/inquiry.sender.js",
    "skill:inquiry-send:list": "node skills/wholesale/inquiry.sender.js --list",
    "skill:inquiry-send:dry": "node skills/wholesale/inquiry.sender.js --dry-run",
    "mcp:start": "node mcp-server/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dotenv": "^16.3.1",
    "js-yaml": "^4.1.0",
    "playwright": "^1.40.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0"
  }
}
